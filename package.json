{
  "name": "airplane-jam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run -t \"^(?!.*200 solvable).*$\"",
    "gen:levels": "node scripts/generate-levels.ts",
    "gen:art": "node scripts/generate-art.ts",
    "check:levels": "node scripts/check-levels.ts",
    "store:shots": "node scripts/store-shots.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:open": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
